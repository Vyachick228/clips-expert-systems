(deftemplate decision
    (slot id)
    (slot question)
    (slot yes)
    (slot no)
)

(deftemplate result
    (slot id)
    (slot animal)
)

(deffacts animal-tree
    (decision (id size)
        (question very-large)
        (yes neck)
        (no squeak))
    (decision (id squeak)
        (question makes-squeak)
        (yes mouse)
        (no squirrel))
    (decision (id neck)
        (question long-neck)
        (yes giraffe)
        (no trunk))
    (decision (id trunk)
        (question has-trunk)
        (yes elephant)
        (no water))
    (decision (id water)
        (question likes-water)
        (yes hippo)
        (no rhino))
    (result (id mouse) (animal Mouse))
    (result (id squirrel) (animal Squirrel))
    (result (id giraffe) (animal Giraffe))
    (result (id elephant) (animal Elephant))
    (result (id hippo) (animal Hippopotamus))
    (result (id rhino) (animal Rhinoceros))
)
